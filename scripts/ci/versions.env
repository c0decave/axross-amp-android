# The tools the CI installs to build the APK (scripts/ci/android-toolchain.sh
# reads this file; .github/actions/android-toolchain passes the JDK's and
# Gradle's versions on to their setup actions). The NDK's version is in
# android/gradle.properties (amp.ndkVersion): Gradle needs it as well.
# See docs/ARCHITECTURE.md, "Versions".
CARGO_NDK_VERSION=4.1.2
GRADLE_VERSION=8.14.6
JAVA_VERSION=17
