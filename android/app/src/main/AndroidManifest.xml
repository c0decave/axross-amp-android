<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Music from the Storage Access Framework's pickers: no storage
         permission. Playing on with the app hidden or the screen off: a
         foreground service of the type mediaPlayback (Android 9 needs
         FOREGROUND_SERVICE, 14+ also FOREGROUND_SERVICE_MEDIA_PLAYBACK),
         its notification (13+: POST_NOTIFICATIONS, asked for at the first
         play). No INTERNET: no radio, no updater. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vulkan where the device has it, OpenGL ES 3 otherwise (wgpu). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AmpTheme">

        <!-- configChanges: every change Android 16 knows - a rotation, a
             resize, bold text, a new locale reach the Rust side as a new
             surface size or nothing at all; the activity (and android_main)
             are not started again for any of them (one android_main a
             process: MainActivity.onDestroy ends the process).
             enableOnBackInvokedCallback false: Back arrives as a key on
             every Android version (the Rust side closes the list of faces
             with it, or leaves for the home screen). -->
        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|fontWeightAdjustment|grammaticalGender|uiMode|layoutDirection|locale|colorMode|touchscreen|mcc|mnc"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <!-- The shared object android_main lives in (libaxrossamp.so). -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="axrossamp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the process while music plays (see PlaybackService). -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The media notification's buttons (see MediaActions). -->
        <receiver
            android:name=".MediaActions"
            android:exported="false" />
    </application>
</manifest>
